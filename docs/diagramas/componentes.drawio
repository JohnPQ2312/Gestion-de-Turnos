        <mxCell id="server-body" value="TurnServer + TurnRequestHandler: conexiones, protocolo y permisos&#10;Servicios: generación, atención, rellamado, acceso, consultas y administración&#10;Repositorios JDBC: SQL parametrizado, transacciones y bloqueos&#10;DisplayEventHub: avisos posteriores a la confirmación de cambios" style="text;html=0;align=left;verticalAlign=top;fontFamily=Segoe UI;fontSize=18;fontColor=#193540;spacingLeft=14;spacingTop=7;" vertex="1" parent="server">
