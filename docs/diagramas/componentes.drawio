        </mxCell>
        <mxCell id="txt1" value="Tres clientes independientes; CoreServer centraliza reglas y persistencia. Referencia: cc9405e." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=18;fontColor=#193540;fontStyle=0;" vertex="1" parent="1">
