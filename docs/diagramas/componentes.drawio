        <mxCell id="txt0" value="Gestión de Turnos | Componentes" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=30;fontColor=#193540;fontStyle=1;" vertex="1" parent="1">
