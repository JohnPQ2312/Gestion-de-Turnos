        </mxCell>
        <mxCell id="txt7" value="Líneas continuas: solicitudes y respuestas por el mismo canal; la flecha indica quién inicia la operación." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=17;fontColor=#193540;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="946" width="1081.2" height="27" as="geometry" />
        </mxCell>
        <mxCell id="txt8" value="Línea discontinua: canal persistente SUBSCRIBE_DISPLAY; el aviso provoca una nueva consulta de snapshot." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=17;fontColor=#193540;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="976" width="1060.8" height="27" as="geometry" />
        </mxCell>
        <mxCell id="txt9" value="TLS obligatorio fuera de loopback. La configuración TLS de JDBC se administra por separado." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=17;fontColor=#193540;fontStyle=0;" vertex="1" parent="1">
