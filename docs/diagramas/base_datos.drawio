        <mxCell id="txt0" value="Gestión de Turnos | Modelo relacional" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=30;fontColor=#193540;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="6" width="666.0" height="40" as="geometry" />
        </mxCell>
        <mxCell id="txt1" value="Tablas y relaciones del DDL actual. PK: primaria; FK: foránea. Referencia: cc9405e." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=18;fontColor=#193540;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="896.4" height="28" as="geometry" />
        </mxCell>
        <mxCell id="txt2" value="Cada extremo indica cuántas filas de esa tabla pueden relacionarse con una fila de la tabla opuesta." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=17;fontColor=#193540;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1671" width="1020.0" height="27" as="geometry" />
        </mxCell>
        <mxCell id="txt3" value="0..1: opcional; 1: obligatorio; 0..*: ninguna o muchas; UQ: única. El puente indica cruce sin unión." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=17;fontColor=#193540;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1701" width="1020.0" height="27" as="geometry" />
        </mxCell>
        <mxCell id="txt4" value="Una asignación puede tener muchos tickets históricos, pero solo uno LLAMADO o EN_ATENCION a la vez." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=17;fontColor=#193540;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1731" width="1009.8" height="27" as="geometry" />
        </mxCell>
        <mxCell id="txt5" value="Los campos active_* son columnas calculadas con índices únicos: no agregan relaciones foráneas." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=17;fontColor=#193540;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1761" width="969.0" height="27" as="geometry" />
        </mxCell>
        <mxCell id="txt6" value="assignment_id es nulo solo en EN_ESPERA; user_id es opcional. Ver reglas y tipos completos en el SQL." style="text;html=0;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=17;fontColor=#193540;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1791" width="1030.2" height="27" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
