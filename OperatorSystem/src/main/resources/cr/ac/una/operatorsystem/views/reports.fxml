<?xml version="1.0" encoding="UTF-8"?>

<!-- Selección del reporte y su período; ReportsController construye las columnas al recibir los datos. -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.operatorsystem.controller.ReportsController" styleClass="operator-screen" stylesheets="@operator.css">
 <top><VBox spacing="14" styleClass="screen-header">
  <Label text="Consultas" styleClass="screen-title"/>
  <HBox spacing="16" alignment="BOTTOM_LEFT">
   <VBox spacing="6" minWidth="200" HBox.hgrow="ALWAYS">
    <Label text="Consulta" styleClass="field-label"/>
    <ComboBox fx:id="reportCombo" accessibleText="Consulta" prefWidth="360" minWidth="200" maxWidth="Infinity" minHeight="44"/>
   </VBox>
   <VBox spacing="6" minWidth="140">
    <Label text="Desde" styleClass="field-label"/>
    <DatePicker fx:id="fromDatePicker" editable="false" accessibleText="Fecha inicial" prefWidth="170" minWidth="140" minHeight="44"/>
   </VBox>
   <VBox spacing="6" minWidth="140">
    <Label text="Hasta" styleClass="field-label"/>
    <DatePicker fx:id="toDatePicker" editable="false" accessibleText="Fecha final" prefWidth="170" minWidth="140" minHeight="44"/>
   </VBox>
   <Button fx:id="queryButton" text="Consultar" onAction="#runReport" defaultButton="true" disable="true" minWidth="-Infinity" minHeight="44" styleClass="primary-button"/>
  </HBox>
  <Label fx:id="criterionLabel" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" styleClass="secondary-text"/>
 </VBox></top>
 <center><VBox spacing="12">
  <padding><Insets top="20" right="32" bottom="12" left="32"/></padding>
  <Label fx:id="errorLabel" visible="false" managed="false" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" styleClass="notice-label"/>
  <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
   <placeholder><Label text="Sin resultados para mostrar." styleClass="secondary-text"/></placeholder>
  </TableView>
 </VBox></center>
 <bottom><HBox alignment="CENTER_LEFT" styleClass="action-bar">
  <Label fx:id="summaryLabel" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="summary-label"/>
 </HBox></bottom>
</BorderPane>
