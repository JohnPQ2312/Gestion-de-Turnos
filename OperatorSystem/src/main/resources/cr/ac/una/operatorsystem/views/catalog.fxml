<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.operatorsystem.controller.CatalogController" styleClass="operator-screen" stylesheets="@operator.css">
 <top><VBox spacing="10" styleClass="screen-header">
  <Label text="Servicios y ventanillas" styleClass="screen-title"/>
  <Label text="Administre el catálogo de servicios y las ventanillas. Las habilitaciones y asignaciones se configuran en Asignaciones." wrapText="true" minHeight="-Infinity" styleClass="secondary-text"/>
 </VBox></top>
 <center><TabPane tabClosingPolicy="UNAVAILABLE">
  <tabs>
   <Tab text="Servicios"><fx:include fx:id="services" source="services.fxml"/></Tab>
   <Tab text="Ventanillas"><fx:include fx:id="windows" source="windows.fxml"/></Tab>
  </tabs>
 </TabPane></center>
</BorderPane>
