<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/13"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cr.ac.una.operatorsystem.controller.OperatorController"
      spacing="12.0"
      prefWidth="500.0"
      prefHeight="300.0">

    <padding>
        <Insets top="20.0" right="20.0"
                bottom="20.0" left="20.0"/>
    </padding>

    <children>
        <Label text="Atención de turnos"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <Label text="Asignación de operador y ventanilla"/>

        <ComboBox fx:id="assignmentCombo"
                  editable="false" disable="true"
                  promptText="Pendiente de conexión al servidor"
                  prefWidth="440.0"/>

        <HBox spacing="10.0">
            <children>
                <Button fx:id="callNextButton"
                        text="Llamar siguiente"
                        disable="true"
                        onAction="#callNext"/>

                <Button fx:id="reloadAssignmentsButton"
                        text="Actualizar asignaciones"
                        disable="true"
                        onAction="#reloadAssignments"/>
            </children>
        </HBox>

        <Label text="Turno actual:"
               style="-fx-font-weight: bold;"/>

        <Label fx:id="activeTicketLabel"
               text="Seleccione una asignación para consultar su turno."
               wrapText="true"/>
    </children>
</VBox>
