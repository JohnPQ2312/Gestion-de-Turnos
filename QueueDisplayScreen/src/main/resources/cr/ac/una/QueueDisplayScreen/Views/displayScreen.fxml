<?xml version="1.0" encoding="UTF-8"?>

<!-- Vista pública: anuncio del turno llamado arriba a todo el ancho y turnos activos paginados debajo, actualizada por DisplayScreenController. Sin desplazamiento manual. -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.QueueDisplayScreen.controller.DisplayScreenController" stylesheets="@display.css" styleClass="public-display">
 <top><HBox alignment="CENTER_LEFT" spacing="20" styleClass="display-header">
  <Label text="Sistema de turnos" styleClass="display-title"/>
  <Region HBox.hgrow="ALWAYS"/>
  <Label fx:id="clockLabel" text="--:--:--" styleClass="display-clock"/>
 </HBox></top>
 <center><VBox spacing="12" minHeight="0">
  <padding><Insets top="0" right="28" bottom="12" left="28"/></padding>
  <GridPane fx:id="lastCallPanel" hgap="28" minHeight="-Infinity" maxWidth="Infinity" styleClass="last-call">
   <columnConstraints>
    <ColumnConstraints percentWidth="50" minWidth="0"/>
    <ColumnConstraints percentWidth="17" minWidth="0"/>
    <ColumnConstraints percentWidth="33" minWidth="0"/>
   </columnConstraints>
   <VBox fx:id="codeBlock" GridPane.columnIndex="0" alignment="CENTER_LEFT" minWidth="0" maxWidth="Infinity">
    <HBox spacing="16" alignment="BASELINE_LEFT">
     <Label text="Turno llamado" styleClass="call-caption" minWidth="-Infinity"/>
     <Label fx:id="callNoticeLabel" visible="false" managed="false" styleClass="call-notice" minWidth="-Infinity"/>
    </HBox>
    <Label fx:id="lastCalledLabel" text="—" styleClass="call-code"/>
   </VBox>
   <VBox fx:id="windowBlock" GridPane.columnIndex="1" alignment="CENTER_LEFT" minWidth="0" maxWidth="Infinity">
    <Label text="Ventanilla" styleClass="call-caption"/>
    <Label fx:id="lastWindowLabel" text="—" styleClass="call-window"/>
   </VBox>
   <VBox GridPane.columnIndex="2" spacing="6" alignment="CENTER_LEFT" minWidth="0" maxWidth="Infinity">
    <Label text="Servicio" styleClass="call-caption"/>
    <Label fx:id="lastCallDetailsLabel" text="" wrapText="true" maxWidth="Infinity" maxHeight="68" styleClass="call-details"/>
    <Label fx:id="lastStateLabel" text="" wrapText="true" maxWidth="Infinity" styleClass="call-state"/>
   </VBox>
  </GridPane>
  <VBox spacing="6" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS">
   <HBox alignment="BOTTOM_LEFT" spacing="16">
    <Label text="Turnos activos" styleClass="section-title"/>
    <Region HBox.hgrow="ALWAYS"/>
    <Label fx:id="pageLabel" text="" styleClass="page-label"/>
   </HBox>
   <VBox minHeight="0" VBox.vgrow="ALWAYS">
    <GridPane fx:id="listHeader" styleClass="list-header" maxWidth="Infinity"/>
    <VBox fx:id="rowsBox" minHeight="0" prefHeight="0" maxHeight="Infinity" VBox.vgrow="ALWAYS" styleClass="rows-box"/>
   </VBox>
   <Label fx:id="listNoteLabel" text="" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" styleClass="list-note"/>
  </VBox>
 </VBox></center>
 <bottom><Label fx:id="connectionLabel" text="Conectando con el servidor…" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" styleClass="connection-label"/></bottom>
</BorderPane>
